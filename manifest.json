{
  "manifest_version": 3,
  "name": "页注 · 网页高亮与批注",
  "short_name": "页注",
  "version": "1.0.0",
  "description": "选中网页文字即可高亮、划线，或在右侧写下一条轻巧的批注。所有内容只保存在本地。",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "页注 · 网页批注",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["shared/constants.js", "content/styles.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "打开或关闭本页批注栏"
    },
    "highlight-selection": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "用琥珀黄高亮所选文字"
    },
    "add-note": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "为所选文字添加一条笔记"
    }
  }
}
